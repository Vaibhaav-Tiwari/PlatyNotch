<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Used only with a Developer ID signature (hardened runtime). Not sandboxed: the app runs
  the bundled core and mediaremote-adapter, reads other apps through Accessibility, and
  serves a socket under ~/Library/Application Support/PlatyNotch. Under the hardened
  runtime, EventKit needs the calendars entitlement; it covers both Calendar (meetings,
  quick-add events) and Reminders: the hardened runtime has no separate reminders entitlement.
  Weather (Open-Meteo over https) needs nothing: the app is not sandboxed. The music
  visualiser's CoreAudio process tap is audio input: audio-input lets the hardened runtime
  allow it (verify on a Developer ID build, scripts/verify-widgets.md #39).
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
