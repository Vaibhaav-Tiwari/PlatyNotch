<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Used only with a Developer ID signature (hardened runtime). Not sandboxed: the app runs
  the bundled core and mediaremote-adapter, reads other apps through Accessibility, and
  serves a socket under ~/Library/Application Support/PlatyNotch. Under the hardened
  runtime, EventKit (Today view meetings) needs the calendars entitlement.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
</dict>
</plist>
